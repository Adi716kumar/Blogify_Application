<!DOCTYPE html>
<html lang="en">
<head>
     <%- include('partials/head') %>
    <meta charset="UTF-8">
    <title>Admin Dashboard</title>

    <style>
        :root{
            --bg1: #0f172a;
            --bg2: #0b1220;
            --accent1: #7c3aed;
            --accent2: #06b6d4;
            --glass: rgba(255,255,255,0.06);
            --muted: rgba(255,255,255,0.7);
        }

        html,body{
            height:100%;
            background: linear-gradient(135deg,var(--bg1) 0%, var(--bg2) 60%);
            color: #eef2ff;
            font-family: Inter,ui-sans-serif,system-ui;
        }

        .page-wrap{
            min-height:100vh;
            padding:40px 20px;
            display:flex;
            flex-direction:column;
            gap:30px;
        }

        .hero{
            max-width:1100px;
            margin:0 auto;
            display:flex;
            align-items:center;
            padding:20px;
            border-radius:14px;
            background: rgba(255,255,255,0.03);
            border:1px solid rgba(255,255,255,0.05);
        }

        .hero h1{
            margin:0;
            font-size:28px;
        }

        /* GRID FOR CARDS */
        .grid{
            max-width:1100px;
            margin:0 auto;
            display:grid;
            grid-template-columns: repeat(4, 1fr);
            gap:20px;
        }

        .card{
            background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
            border-radius:12px;
            padding:24px;
            border:1px solid rgba(255,255,255,0.05);
            cursor:pointer;
            transition: all 0.3s ease;
            display:flex;
            flex-direction:column;
            justify-content:center;
            align-items:flex-start;
            min-height:150px;
            
        }

        .card:hover{
            transform: translateY(-6px) scale(1.02);
            border-color: var(--accent2);
            box-shadow: 0 10px 30px rgba(6,182,212,0.2);
        }

        .card h2{
            margin:0;
            font-size:20px;
        }

        .card p{
            margin-top:8px;
            color:var(--muted);
            font-size:14px;
        }

        /* Responsive */
        @media(max-width:900px){
            .grid{
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media(max-width:500px){
            .grid{
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <%- include('partials/nav') %>

    <div class="page-wrap">

        <!-- Header -->
        <div class="hero">
            <h1>Admin Dashboard</h1>
        </div>

        <!-- Cards -->
        <div class="grid">

            <!-- All Blogs -->
            <div class="card" style = "color: rgb(155, 18, 18);" onclick="navigate('/admin/blogs')">
                <h2>All Blogs</h2>
                <p><%= stats.totalBlogs %> total blogs</p>
            </div>

            <!-- All Comments -->
            <div class="card" style = "color: rgb(12, 157, 68);" onclick="navigate('/admin/comments')">
                <h2>All Comments</h2>
                <p><%= stats.totalComments %> total comments</p>
            </div>

            <!-- Pending Blogs -->
            <div class="card" style = "color: rgb(24, 24, 177);" onclick="navigate('/admin/pending-blogs')">
                <h2>Pending Blogs</h2>
                <p><%= stats.pendingBlogsCount %> awaiting review</p>
            </div>

            <!-- Pending Comments -->
            <div class="card" style = "color: rgb(175, 175, 16);" onclick="navigate('/admin/pending-comments')">
                <h2>Pending Comments</h2>
                <p><%= stats.pendingCommentsCount %> awaiting review</p>
            </div>

        </div>

    </div>

    <script>
        function navigate(path){
            window.location.href = path;
        }
    </script>
    <%- include('partials/footer') %>

<%- include('partials/scripts') %>

</body>
</html>