<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <meta charset="UTF-8">
    <title>All Blogs - Admin</title>

    <style>
        :root{
            --bg1: #0f172a;
            --bg2: #0b1220;
            --accent1: #7c3aed;
            --accent2: #06b6d4;
            --danger: #ef4444;
            --glass: rgba(255,255,255,0.06);
            --muted: rgba(255,255,255,0.7);
        }

        body{
            background: linear-gradient(135deg,var(--bg1), var(--bg2));
            color: #eef2ff;
            font-family: Inter, sans-serif;
            margin:0;
        }

        .container{
            width:80%;
            margin:40px auto;
        }

        h1{
            margin-bottom:30px;
        }

        .blog-card{
            display:flex;
            justify-content:space-between;
            align-items:center;
            background: rgba(255,255,255,0.03);
            padding:18px 22px;
            border-radius:12px;
            margin-bottom:16px;
            border:1px solid rgba(255,255,255,0.05);
            transition:0.3s;
        }

        .blog-card:hover{
            transform: translateY(-3px);
            border-color: var(--accent2);
            box-shadow: 0 8px 25px rgba(6,182,212,0.2);
        }

        .blog-info{
            display:flex;
            flex-direction:column;
        }

        .blog-title{
            font-size:18px;
            font-weight:600;
        }

        .blog-author{
            font-size:14px;
            color:var(--muted);
            margin-top:4px;
        }

        .delete-btn{
            background: transparent;
            border:1px solid var(--danger);
            color: var(--danger);
            padding:8px 14px;
            border-radius:8px;
            cursor:pointer;
            transition:0.3s;
        }

        .delete-btn:hover{
            background: var(--danger);
            color:white;
        }

    </style>
</head>

<body>

    <!-- Optional navbar -->
    <%- include('partials/nav') %>

    <div class="container">
        <h1>All Blogs</h1>

        <% if (blogs && blogs.length > 0) { %>
            <% blogs.forEach(blog => { %>

                <div class="blog-card">
                    <div class="blog-info" onclick="navigate('/blog/<%= blog._id %>')">
                        <div class="blog-title"><%= blog.title %></div>
                        <div class="blog-author">By <%= blog.createdBy.fullName %></div>
                    </div>

                    <form action="/admin/delete-blog/<%= blog._id %>" method="POST">
                        <button class="delete-btn">Delete</button>
                    </form>
                </div>

            <% }) %>
        <% } else { %>
            <p>No blogs found.</p>
        <% } %>

    </div>
    <script>
        function navigate(path){
            window.location.href = path;
        }
    </script>
    <%- include('partials/scripts') %>
</body>
</html>